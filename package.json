{
  "name": "puzzmo-stats",
  "version": "0.1.0",
  "description": "Display Puzzmo streak stats, loaded with ATProto",
  "license": "ISC",
  "author": "Christopher Bennell",
  "type": "module",
  "main": "./dist/puzzmo-stats.iife.min.js",
  "module": "./dist/puzzmo-stats.js",
  "types": "./dist/puzzmo-stats.d.ts",
  "exports": {
    ".": {
      "types": "./dist/puzzmo-stats.d.ts",
      "import": "./dist/puzzmo-stats.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && node build.mjs && tsc --emitDeclarationOnly",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@lit/task": "^1.0.3",
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@lit/task": "^1.0.3",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.9.0",
    "lit": "^3.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
